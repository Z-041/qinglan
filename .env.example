# =============================================================================
# 青栏部署环境变量模板（复制为 .env 后填值；.env 已被仓库根 .gitignore 忽略）
#
#   cp .env.example .env
#
# 这是「一套环境变量部署全栈」的唯一真源：
#   - docker compose 的 app 服务以 env_file: .env 把这些变量注入后端容器；
#   - 后端读取的是镜像内 /app/config/application.yml（由 application.example.yml 落成）
#     里的 ${...} 占位符，因此【下面每一项的名字与后端配置键一一对应】，
#     改名必须同时改 application.example.yml 并重跑核对（见 deploy/README.md）。
#
# 标记含义：
#   [必填]      不填 → 应用起不来或被 prod 启动守卫拒绝
#   [不可轮换]  上线写死后不可再改，改了历史数据无法匹配/解密（必须离线备份）
#   [生产必须]  生产必须取该值，本地/测试可不同
#
# 生成随机密钥的参考命令（openssl）：
#   QINGLAN_JWT_SECRET:        openssl rand -base64 48
#   QINGLAN_CRYPTO_AES_KEY:    openssl rand -base64 32          # 恰好 32 字节
#   QINGLAN_CRYPTO_EMAIL_PEPPER: openssl rand -base64 32        # 任意长度，越长越好
#   QINGLAN_STORAGE_IMAGE_SIGNING_SECRET: openssl rand -base64 48
#   MYSQL_ROOT_PASSWORD / QINGLAN_DB_PASSWORD / REDIS_PASSWORD: openssl rand -base64 24
# =============================================================================

# -----------------------------------------------------------------------------
# 运行时 profile（决定是否触发生产启动守卫）
# -----------------------------------------------------------------------------
# [必填][生产必须] prod。激活后 ProdEnvironmentGuard 会校验并拒绝以下任一配置：
#   - qinglan.auth.expose-code=true
#   - qinglan.auth.code-store != redis
#   - qinglan.store.type != redis
#   - qinglan.storage.type != s3（生产必须把图片放对象存储，不能落应用服务器本地磁盘）
#   - qinglan.storage.image-signing-secret 未显式配置（不得依赖回落到 QINGLAN_JWT_SECRET）
#   - spring.jpa.hibernate.ddl-auto in {create, create-drop, update}
#   - spring.datasource.url 指向 localhost / 127.0.0.1 / ::1 / 0.0.0.0
# 不设或设错 → 生产会用本地态（回显验证码、内存存储）静默起来，属事故。
SPRING_PROFILES_ACTIVE=prod

# -----------------------------------------------------------------------------
# MySQL（compose 的 mysql 服务 + 后端数据源）
# -----------------------------------------------------------------------------
# [必填] 容器内 root 口令；仅 compose 建库/运维用，后端不使用 root
MYSQL_ROOT_PASSWORD=
# 库名；compose 用它在容器里建库（默认 qinglan，与 QINGLAN_DB_URL 里的库名保持一致）
QINGLAN_DB_NAME=qinglan
# [必填] 应用专用账号（最小权限）；compose 用它建号，后端用它连库
QINGLAN_DB_USERNAME=qinglan
# [必填] 应用账号口令
QINGLAN_DB_PASSWORD=
# [必填][生产必须] 后端 JDBC URL。主机名必须是 compose 服务名 mysql，且指向非本机地址
# （prod 守卫据此判定「不是本机库」）。
# 参数保持与 application.example.yml 一致：utf8 编码 + serverTimezone=UTC，与 mysql 服务的
# --default-time-zone=+00:00 对齐。
QINGLAN_DB_URL=jdbc:mysql://mysql:3306/qinglan?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC&useSSL=false&allowPublicKeyRetrieval=true

# -----------------------------------------------------------------------------
# Redis 7
# -----------------------------------------------------------------------------
# [必填][生产必须] Redis 访问口令。compose 的 redis 服务以 --requirepass 生效；
# 后端经 spring.data.redis.password 使用，两处必须一致，否则 Redis 连接全失败。
REDIS_PASSWORD=
QINGLAN_REDIS_HOST=redis
QINGLAN_REDIS_PORT=6379
# 后端读取的口令（须与 REDIS_PASSWORD 相同）
QINGLAN_REDIS_PASSWORD=
# [生产必须] true：生产用 Redis，把 Redis 纳入 /actuator/health；否则健康检查会漏掉 Redis 故障
QINGLAN_REDIS_HEALTH=true

# -----------------------------------------------------------------------------
# 密钥（安全红线：只允许环境变量注入，禁止写死进代码/镜像；AGENTS.md 第九章）
# -----------------------------------------------------------------------------
# [必填][不可轮换] AES-256 密钥（32 字节 Base64），用于加密存储学号等身份字段。
# 一旦轮换，旧密文无法解密 → 除依法调查通道外无人能还原历史身份。必须离线备份。
QINGLAN_CRYPTO_AES_KEY=
# [必填][不可轮换] 邮箱/学号不可逆哈希的固定盐（email pepper）。轮换即导致历史用户
# 无法再匹配（同邮箱算出不同 hash）→ 等于丢掉账号关联能力。必须离线备份。
QINGLAN_CRYPTO_EMAIL_PEPPER=
# [必填] JWT 签名密钥（≥32 字节 Base64）。轮换会使已签发令牌立即失效（用户需重新登录），
# 属可轮换但会影响在线会话的项。
QINGLAN_JWT_SECRET=

# -----------------------------------------------------------------------------
# 认证 / 验证码邮件
# -----------------------------------------------------------------------------
# [必填][生产必须] redis。memory 在多实例/重启下验证码不共享、重启即丢
QINGLAN_AUTH_CODE_STORE=redis
# [必填] 校园邮箱域名白名单（逗号分隔）。留空 = 拒绝所有邮箱（fail-closed）
QINGLAN_AUTH_EMAIL_DOMAINS=
# [生产必须] false。为 true 会在接口响应里回显验证码（仅供本地联调），prod 守卫会拒绝启动
QINGLAN_AUTH_EXPOSE_CODE=false
# [生产必须] smtp。logging = 只把验证码打进日志（本地/CI 默认），生产会把验证码泄进日志
QINGLAN_AUTH_MAIL_TRANSPORT=smtp
# SMTP 服务商参数（以服务商文档为准；587 一般开 STARTTLS，465 隐式 TLS 另配）
QINGLAN_AUTH_MAIL_HOST=
QINGLAN_AUTH_MAIL_PORT=587
QINGLAN_AUTH_MAIL_USERNAME=
# [必填] SMTP 口令；只允许环境变量注入
QINGLAN_AUTH_MAIL_PASSWORD=
QINGLAN_AUTH_MAIL_FROM=no-reply@qinglan.edu.cn
QINGLAN_AUTH_MAIL_TLS=true

# -----------------------------------------------------------------------------
# 短时效存储 / 上传 / 安全（限流与代理）
# -----------------------------------------------------------------------------
# [必填][生产必须] redis。与 code-store 同理：memory 在多实例下计数/一次性令牌不共享
QINGLAN_STORE_TYPE=redis
# [必填][生产必须] s3：上传文件落 S3 兼容对象存储，不落应用服务器本地磁盘（AGENTS.md 第九章）。
# local 在多实例下不共享、且随容器重建丢失，prod 守卫会拒绝启动。
QINGLAN_STORAGE_TYPE=s3
# [必填][生产必须] 私有图片（待审 / 下架 / 未绑定上传）签名 URL 的 HMAC 密钥。
# 生产不得依赖回落到 QINGLAN_JWT_SECRET（生成参考：openssl rand -base64 48）。
# 轮换会使**已签发的图片链接立即失效**（用户刷新页面即可拿到新链接），影响面小于 JWT 轮换。
QINGLAN_STORAGE_IMAGE_SIGNING_SECRET=
# S3 兼容对象存储（自建 MinIO / 腾讯 COS / 阿里 OSS 均可）。下面四项必填，缺失即启动失败并给出中文原因。
#   endpoint   形如 https://minio.example.com:9000（自建 MinIO）或厂商给的 endpoint
#   region     自建 MinIO 可留空（默认 us-east-1）；云厂商按其文档填
#   bucket     单独给青栏建桶（不要把别的业务数据混在同一个桶里）
QINGLAN_S3_ENDPOINT=
QINGLAN_S3_REGION=
QINGLAN_S3_BUCKET=
# [必填] 对象存储访问凭据；只允许环境变量注入，禁止写死进代码/镜像
QINGLAN_S3_ACCESS_KEY=
QINGLAN_S3_SECRET_KEY=
# 上传目录（容器内路径，仅 QINGLAN_STORAGE_TYPE=local 时生效）。与 Dockerfile 的 /app/data/uploads、
# compose 的 uploads-data 卷一致；生产用 s3 时本项不再生效（卷可退场）
QINGLAN_STORAGE_ROOT=/app/data/uploads
# 孤儿回收：上传后超过保留期仍未绑定到任何帖子的对象会被删除（对象 + 登记行）
QINGLAN_UPLOAD_ORPHAN_CLEANUP_ENABLED=true
QINGLAN_UPLOAD_ORPHAN_RETENTION=24h
# [必填][生产必须] 1：本部署只有一层 nginx 反代。后端按此值从 X-Forwarded-For 右起取
# 「真实客户端 IP」。设 0 会把 nginx 容器 IP 当成全体用户（限流维度错误、形同虚设）；
# 设错（如 2）会取到可被伪造的跳。
QINGLAN_TRUSTED_PROXY_HOPS=1
# IP 限流（保护 /api/auth/email/code 等敏感端点）
QINGLAN_RATE_LIMIT_ENABLED=true
QINGLAN_RATE_LIMIT_MAX=20

# -----------------------------------------------------------------------------
# 部署编排（仅 compose 使用，后端不读）
# -----------------------------------------------------------------------------
# 对外 HTTP 端口（nginx）
HTTP_PORT=80
# 后端镜像 tag。回滚时把它改成上一个 tag 再 `docker compose up -d app`（见 deploy/README.md）
QINGLAN_IMAGE_TAG=local
